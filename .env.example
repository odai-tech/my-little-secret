# Joy: order & payment server settings.
# Copy to .env for `npm start`, or add each one in Vercel → Project → Settings → Environment Variables.
# Never commit the real .env (it is in .gitignore) and never put secret keys in assets/js/config.js.

# ── payments ────────────────────────────────────────────────────────────────
# stripe | hosted | mock | none   (none or empty: no online payment, orders go by email/WhatsApp)
PAYMENT_PROVIDER=none

# Stripe (Dashboard → Developers → API keys / Webhooks). Use sk_test_/pk_test_ keys until launch.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Israeli hosted payment page (Grow, Tranzila, Cardcom, PayPlus…): add the keys your
# provider gives you here, then fill in server/lib/providers/hosted.js.
# PROVIDER_API_KEY=

# mock: a pretend payment page for testing the whole flow. Refuses to run in production.
MOCK_SECRET=

# Offer "Pay later" (on delivery or pickup) next to "Pay now". false = pay now only.
PAY_LATER=true

# ── addresses ───────────────────────────────────────────────────────────────
# The public site address; customers come back here after paying. Set it in production.
SITE_URL=https://www.example.com/
# Only when the API runs on a different address than the site:
# PUBLIC_API_URL=https://pay.example.com/api
# ALLOWED_ORIGINS=https://www.example.com,https://odai-tech.github.io

# ── tell the shop about paid orders (use any or all) ────────────────────────
# A webhook (Zapier, Make, n8n…) that forwards to WhatsApp, Telegram, Sheets…
NOTIFY_WEBHOOK_URL=
# Email through Resend (resend.com)
RESEND_API_KEY=
NOTIFY_EMAIL=mylittlesecret782@gmail.com
# NOTIFY_FROM=Joy orders <orders@your-domain.com>

# ── limits ──────────────────────────────────────────────────────────────────
# Orders one visitor can start per 10 minutes.
RATE_LIMIT_PER_10MIN=20
# Port for `npm start`.
PORT=3000
